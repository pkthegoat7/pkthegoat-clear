# ============================================
# Painel pkthegoat — variáveis de ambiente
# ============================================
# Copie este arquivo para .env (LOCAL) ou configure
# como variáveis no Railway/Render/etc.
# NUNCA commite o .env real — já está no .gitignore.

# --- Conta admin do painel ---
# Seu e-mail. Obrigatório para o login admin funcionar. NUNCA commite o valor real.
ADMIN_EMAIL=seu-email@exemplo.com

# --- Supabase (storage persistente) ---
# Encontre em: dashboard.supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service_role-do-dashboard

# --- Criptografia dos tokens Discord no banco (AES-256-GCM) ---
# Gere uma vez com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se trocar, perde acesso a todas as tokens já salvas!
ENCRYPTION_KEY=gere-com-node-randomBytes-32-em-base64

# --- Servidor HTTP ---
# PORT é injetado automaticamente pelo Railway/Render
# PKTHEGOAT_SECURE_COOKIES=1 ativa flag Secure no cookie (use em produção HTTPS)
PKTHEGOAT_SECURE_COOKIES=1

# --- Login com Discord (OAuth2) ---
# Crie uma aplicação em https://discord.com/developers/applications
# Em OAuth2 → copie o Client ID e gere o Client Secret.
DISCORD_CLIENT_ID=cole-aqui-o-client-id
DISCORD_CLIENT_SECRET=cole-aqui-o-client-secret
# Base pública do painel (produção). Usada para montar a URL de retorno do Discord.
# Local você pode deixar em branco (usa http://127.0.0.1:PORT automaticamente).
PKTHEGOAT_BASE_URL=https://SEU-APP.up.railway.app
# (Opcional) Sobrescreve a URL de retorno completa. Por padrão é
# {PKTHEGOAT_BASE_URL}/api/auth/discord/callback — cadastre ESSA url no portal do Discord.
# DISCORD_REDIRECT_URI=
# Seu Discord ID (numérico). Quem logar com esse Discord vira super-admin.
# Como achar: Discord → Config → Avançado → Modo desenvolvedor; clique no seu nome → Copiar ID.
SUPERADMIN_DISCORD_ID=cole-aqui-seu-discord-id

# --- Tracker API próprio (Railway) ---
# Fonte adicional na busca de usuários: histórico de nomes/avatares, presença,
# voz e atividades gravados pelo self-bot que roda no Railway.
# URL padrão é a do projeto pkthegoat7/discord-tracker no Railway.
TRACKER_API_URL=https://tracker-production-2b17.up.railway.app
# Header X-API-Key. Sem isso, a integração fica desativada silenciosamente.
TRACKER_API_KEY=cole-aqui-a-chave-do-tracker

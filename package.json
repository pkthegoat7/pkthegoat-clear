{
  "name": "pkthegoat-clear",
  "version": "1.0.12",
  "description": "GoatCord - Discord Self-Bot Completo",
  "main": "electron/bootstrap.js",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "app:build": "electron-builder --win nsis",
    "app:portable": "electron-builder --win portable",
    "format": "biome format --write .",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.pkthegoat.clear",
    "productName": "GoatCord",
    "directories": {
      "output": "dist-electron"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GoatCord",
      "artifactName": "GoatCord-setup.exe"
    },
    "portable": {
      "artifactName": "GoatCord-portable.exe"
    }
  },
  "keywords": [
    "discord",
    "selfbot",
    "discord-bot",
    "discord-selfbot",
    "message-cleaner",
    "discord-tools"
  ],
  "author": "pkthegoat",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkthegoat7/pkthegoat-clear.git"
  },
  "bugs": {
    "url": "https://github.com/pkthegoat7/pkthegoat-clear/issues"
  },
  "homepage": "https://github.com/pkthegoat7/pkthegoat-clear#readme",
  "dependencies": {
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "debug": "^4.4.3",
    "discord-rpc": "^4.0.1",
    "discord.js-selfbot-v13": "https://github.com/brunnoxw/discord.js-selfbot-v13/archive/refs/heads/main.tar.gz",
    "readline-sync": "^1.4.10",
    "yauzl": "^3.2.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "electron": "43.7.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  }
}

{
  "name": "pkthegoat-clear",
  "version": "1.0.9",
  "description": "pkthegoat clear - Discord Self-Bot Completo",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --output dist/pkthegoat-clear.exe",
    "build:win": "pkg . --output dist/pkthegoat-clear-win.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --output dist/pkthegoat-clear-linux",
    "build:mac": "pkg . --targets node22-macos-x64 --output dist/pkthegoat-clear-macos",
    "release": "release.bat",
    "format": "biome format --write ."
  },
  "bin": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "pkg": {
    "assets": [
      "node_modules/discord.js-selfbot-v13/**",
      "node_modules/@stablelib/xchacha20poly1305/**",
      "node_modules/discord-rpc/**",
      "node_modules/yauzl/**",
      "src/services/rpc-server-standalone.js",
      "src/ui/rpc-config.html",
      "src/ui/web-ui.html"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "node-sqlite-shim.js",
      "src/services/rpc-server-standalone.js"
    ],
    "ignore": [
      "node:sqlite"
    ]
  },
  "keywords": [
    "discord",
    "selfbot",
    "discord-bot",
    "discord-selfbot",
    "message-cleaner",
    "discord-tools"
  ],
  "author": "pkthegoat",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunnoxw/brunnoclear.git"
  },
  "bugs": {
    "url": "https://github.com/brunnoxw/brunnoclear/issues"
  },
  "homepage": "https://github.com/brunnoxw/brunnoclear#readme",
  "dependencies": {
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "debug": "^4.4.3",
    "discord-rpc": "^4.0.1",
    "discord.js-selfbot-v13": "https://github.com/brunnoxw/discord.js-selfbot-v13/archive/refs/heads/main.tar.gz",
    "readline-sync": "^1.4.10",
    "yauzl": "^3.2.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@yao-pkg/pkg": "^5.15.0",
    "patch-package": "^8.0.1"
  }
}

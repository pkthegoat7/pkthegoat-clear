{
  "name": "pkthegoat-clear",
  "version": "1.0.9",
  "description": "pkthegoat clear - Discord Self-Bot Completo",
  "main": "electron/main.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --output dist/pkthegoat-clear.exe",
    "build:local": "pkg local.js --config package.json --targets node22-win-x64 --output dist/pkthegoat-clear-local.exe",
    "start:local": "node local.js",
    "app": "electron .",
    "app:build": "electron-builder --win nsis",
    "build:win": "pkg . --output dist/pkthegoat-clear-win.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --output dist/pkthegoat-clear-linux",
    "build:mac": "pkg . --targets node22-macos-x64 --output dist/pkthegoat-clear-macos",
    "release": "release.bat",
    "format": "biome format --write .",
    "test": "node --test \"test/**/*.test.js\""
  },
  "bin": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "pkg": {
    "assets": [
      "node_modules/discord.js-selfbot-v13/**",
      "node_modules/@stablelib/xchacha20poly1305/**",
      "node_modules/discord-rpc/**",
      "node_modules/yauzl/**",
      "src/services/rpc-server-standalone.js",
      "src/ui/rpc-config.html",
      "src/ui/web-ui.html",
      "src/ui/login.html",
      "src/ui/conta-2fa.html",
      "src/ui/vendor/qrcode.min.js",
      "src/ui/assets/disclaw_icon.svg",
      "src/ui/assets/disclaw_wordmark.svg"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "node-sqlite-shim.js",
      "src/services/rpc-server-standalone.js"
    ],
    "ignore": [
      "node:sqlite"
    ]
  },
  "build": {
    "appId": "com.pkthegoat.clear",
    "productName": "pkthegoat clear",
    "directories": {
      "output": "dist-electron"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "files": [
      "electron/**/*",
      "index.js",
      "local.js",
      "src/**/*",
      "extensao-discord/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pkthegoat clear",
      "artifactName": "pkthegoat-clear-setup.exe"
    }
  },
  "keywords": [
    "discord",
    "selfbot",
    "discord-bot",
    "discord-selfbot",
    "message-cleaner",
    "discord-tools"
  ],
  "author": "pkthegoat",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkthegoat7/pkthegoat-clear.git"
  },
  "bugs": {
    "url": "https://github.com/pkthegoat7/pkthegoat-clear/issues"
  },
  "homepage": "https://github.com/pkthegoat7/pkthegoat-clear#readme",
  "dependencies": {
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "debug": "^4.4.3",
    "discord-rpc": "^4.0.1",
    "discord.js-selfbot-v13": "https://github.com/brunnoxw/discord.js-selfbot-v13/archive/refs/heads/main.tar.gz",
    "readline-sync": "^1.4.10",
    "yauzl": "^3.2.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@yao-pkg/pkg": "^5.15.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  }
}

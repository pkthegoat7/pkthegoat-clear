{
  "manifest_version": 3,
  "name": "pkthegoat — Discord web do self",
  "version": "1.1.0",
  "description": "Abre o Discord web logado como uma conta (token) salva no painel pkthegoat, em nova aba ou embutido na aba Tela do self. Áudio e microfone nativos.",
  "permissions": ["scripting", "tabs", "storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://painel.disclaw.cc/*",
    "https://discord.com/*",
    "https://*.discord.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ruleset_1", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://painel.disclaw.cc/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://discord.com/*"],
      "js": ["content-discord.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}

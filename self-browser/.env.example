# Porta (Railway injeta automaticamente; local usa 8090)
PORT=8090

# Segredo compartilhado com o painel (assina/valida o ticket). Gere um forte:
#   openssl rand -base64 32
BROWSER_SHARED_SECRET=

# MESMOS valores do painel — necessários para ler e decifrar o token do self.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
